# Meta WhatsApp Cloud API (from developers.facebook.com -> your app -> WhatsApp)
VERIFY_TOKEN=pick-any-secret-string
WHATSAPP_TOKEN=your-permanent-access-token
PHONE_NUMBER_ID=your-phone-number-id
GRAPH_API_VERSION=v24.0
# Owner dashboard login (CHANGE these before giving to a client)
OWNER_USER=admin
OWNER_PASSWORD=change-me-please
# Missed-call text-back: shared secret for the notifier (phone app / telephony
# webhook) that POSTs to /api/missed-call. If unset, that endpoint falls back
# to owner basic auth.
MISSED_CALL_SECRET=<redacted>
# Minutes before the same caller can get another text-back (anti-spam)
MISSED_CALL_COOLDOWN_MIN=30
# Abuse protection: max /api/missed-call hits per minute per IP, and max
# text-backs actually sent per day (bounds WhatsApp cost if the notifier
# misbehaves or the secret ever leaks)
MISSED_CALL_RATE_PER_MIN=30
MISSED_CALL_DAILY_CAP=200
PORT=5000
