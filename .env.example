# Meta WhatsApp Cloud API (from developers.facebook.com -> your app -> WhatsApp)
VERIFY_TOKEN=pick-any-secret-string
WHATSAPP_TOKEN=your-permanent-access-token
PHONE_NUMBER_ID=your-phone-number-id
GRAPH_API_VERSION=v24.0
# Owner dashboard login (CHANGE these before giving to a client)
OWNER_USER=admin
OWNER_PASSWORD=change-me-please
PORT=5000
